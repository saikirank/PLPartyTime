Open/Closed Principle (OCP) in Swift
“Software entities (classes, modules, functions) should be open for extension, but closed for modification.”


You should be able to extend the behavior of a class without modifying its existing source code.
Helps prevent bugs, improves maintainability, and supports scalable architecture.

protocol Notifiable {
    func send()
}

class EmailNotification: Notifiable {
    func send() {
        print("Send Email")
    }
}

class SMSNotification: Notifiable {
    func send() {
        print("Send SMS")
    }
}

class PushNotification: Notifiable {
    func send() {
        print("Send Push Notification")
    }
}

Liskov Substitution Principle (LSP)

"Objects of a superclass should be replaceable with objects of its subclasses without altering the correctness of the program."
— Barbara Liskov

In Swift terms:
	•	If you have a base class or protocol, its subclass or conforming type should honor the expectations of the base.
	•	Subtypes must be behaviorally substitutable, not just syntactically compatible.

protocol Bird {
    var name: String { get }
}

protocol Flyable {
    func fly()
}

class Sparrow: Bird, Flyable {
    let name = "Sparrow"
    func fly() {
        print("Sparrow is flying")
    }
}

class Ostrich: Bird {
    let name = "Ostrich"
    // No fly method, and that’s OK
}

protocol PaymentMethod {
    func pay(amount: Double) throws
}


Interface Segregation Principle (ISP)

"Clients should not be forced to depend on interfaces they do not use."

In Swift terms:
	•	Don't force conforming types to implement unused protocol requirements.
	•	Break large protocols into smaller, focused protocols.
	•	Encourage composition over inheritance.

protocol Depositable {
    func deposit(amount: Double)
}

protocol Withdrawable {
    func withdraw(amount: Double)
}

protocol Transferable {
    func transfer(to account: Transferable, amount: Double)
}

protocol StatementPrintable {
    func generateStatement()
}

Dependency Inversion:
States that higher level modules should not depend on lower level modules both should depend on abstraction(protocals) .

Lets say in view model having network call, we should not directly use url session, we should use protocal instead.

Where will be having

Protocol NetworkServicing  {

Func request<T: Deocodable> (endpoint: URLRequest) -> AnyPublisher<T, Error>

}

final class NetworkService: NetworkServicing {
    func request<T: Decodable>(_ endpoint: URLRequest) -> AnyPublisher<T, Error> {
        URLSession.shared.dataTaskPublisher(for: endpoint)
            .map(\.data)
            .decode(type: T.self, decoder: JSONDecoder())
            .receive(on: DispatchQueue.main)
            .eraseToAnyPublisher()
    }
}

So that it can be mocked easily and testable.

enum HTTPMethod: String {
    case get = "GET"
    case post = "POST"
    case put = "PUT"
    case delete = "DELETE"
}

enum HTTPHeader {
    case contentType(String)
    case authorization(String)

    var keyValue: (String, String) {
        switch self {
        case .contentType(let type): return ("Content-Type", type)
        case .authorization(let token): return ("Authorization", "Bearer \(token)")
        }
    }
}

enum APIEndpoint {
    case login
    case userProfile(id: Int)
    case updateUser(id: Int)
    
    var path: String {
        switch self {
        case .login: return "/login"
        case .userProfile(let id): return "/users/\(id)"
        case .updateUser(let id): return "/users/\(id)"
        }
    }

    var method: HTTPMethod {
        switch self {
        case .login: return .post
        case .userProfile: return .get
        case .updateUser: return .put
        }
    }

    var headers: [HTTPHeader] {
        [.contentType("application/json")]
    }
    
    var baseURL: URL {
        URL(string: "https://api.example.com")!
    }
}

struct APIRequest {
    let endpoint: APIEndpoint
    let body: Encodable?

    func asURLRequest() -> URLRequest {
        let url = endpoint.baseURL.appendingPathComponent(endpoint.path)
        var request = URLRequest(url: url)
        request.httpMethod = endpoint.method.rawValue

        for header in endpoint.headers {
            let (key, value) = header.keyValue
            request.setValue(value, forHTTPHeaderField: key)
        }

        if let body = body {
            request.httpBody = try? JSONEncoder().encode(AnyEncodable(body))
        }

        return request
    }
}

struct AnyEncodable: Encodable {
    private let encodeFn: (Encoder) throws -> Void
    init<T: Encodable>(_ wrapped: T) {
        self.encodeFn = wrapped.encode
    }
    func encode(to encoder: Encoder) throws {
        try encodeFn(encoder)
    }
}

protocol NetworkServicing {
    func request<T: Decodable>(_ apiRequest: APIRequest) -> AnyPublisher<T, Error>
}

final class NetworkService: NetworkServicing {
    func request<T: Decodable>(_ apiRequest: APIRequest) -> AnyPublisher<T, Error> {
        let urlRequest = apiRequest.asURLRequest()

        return URLSession.shared.dataTaskPublisher(for: urlRequest)
            .map(\.data)
            .decode(type: T.self, decoder: JSONDecoder())
            .receive(on: DispatchQueue.main)
            .eraseToAnyPublisher()
    }
}



